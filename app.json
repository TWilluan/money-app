{
  "expo": {
    "name": "Money Manager",
    "slug": "money-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "money-manager",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneymanager.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.moneymanager.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Money Manager",
      "shortName": "Money",
      "description": "Personal money management app",
      "themeColor": "#0D0F17",
      "backgroundColor": "#0D0F17",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
